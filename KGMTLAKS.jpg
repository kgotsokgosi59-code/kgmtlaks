        <div class="gallery"><figure class="g-item" tabindex="0" style="--ar:1.501" data-full="./imgs/full/golf-01.jpg" data-alt="Drive swing on the tee box"><img src="./imgs/thumb/golf-01.jpg" alt="Drive swing on the tee box" loading="lazy"><span class="tag">Golf day</span></figure><figure class="g-item" tabindex="0" style="--ar:1.501" data-full="./imgs/full/golf-07.jpg" data-alt="Follow-through under a clear blue sky"><img src="./imgs/thumb/golf-07.jpg" alt="Follow-through under a clear blue sky" loading="lazy"><span class="tag">Golf day</span></figure></div>
    </section><section class="group" id="g2">
        <header class="group-head reveal"><span class="gnum">02</span><div><h2>Tee-off &amp; putting</h2><p>Lining it up, teeing up and rolling it home.</p></div><span class="gcount">6 photos</span></header>
        <div class="gallery"><figure class="g-item" tabindex="0" style="--ar:1.55" data-full="./imgs/full/golf-05.jpg" data-alt="Teeing up with the driver"><img src="./imgs/thumb/golf-05.jpg" alt="Teeing up with the driver" loading="lazy"><span class="tag">Golf day</span></figure><figure class="g-item" tabindex="0" style="--ar:1.501" data-full="./imgs/full/golf-02.jpg" data-alt="Placing the ball on the tee"><img src="./imgs/thumb/golf-02.jpg" alt="Placing the ball on the tee" loading="lazy"><span class="tag">Golf day</span></figure><figure class="g-item" tabindex="0" style="--ar:1.512" data-full="./imgs/full/golf-09.jpg" data-alt="Crouching to set the tee"><img src="./imgs/thumb/golf-09.jpg" alt="Crouching to set the tee" loading="lazy"><span class="tag">Golf day</span></figure><figure class="g-item" tabindex="0" style="--ar:1.501" data-full="./imgs/full/golf-06.jpg" data-alt="Lining up a putt on the green"><img src="./imgs/thumb/golf-06.jpg" alt="Lining up a putt on the green" loading="lazy"><span class="tag">Golf day</span></figure><figure class="g-item" tabindex="0" style="--ar:1.699" data-full="./imgs/full/golf-03.jpg" data-alt="Putter, ball and cup"><img src="./imgs/thumb/golf-03.jpg" alt="Putter, ball and cup" loading="lazy"><span class="tag">Golf day</span></figure><figure class="g-item" tabindex="0" style="--ar:1.501" data-full="./imgs/full/golf-11.jpg" data-alt="Putting from a distance"><img src="./imgs/thumb/golf-11.jpg" alt="Putting from a distance" loading="lazy"><span class="tag">Golf day</span></figure></div>
    </section><section class="group" id="g3">
