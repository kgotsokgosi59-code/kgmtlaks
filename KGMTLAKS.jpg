        <div class="gallery"><figure class="g-item" tabindex="0" style="--ar:1.484" data-full="./imgs/full/golf-08.jpg" data-alt="Shoes and driver head, close up"><img src="./imgs/thumb/golf-08.jpg" alt="Shoes and driver head, close up" loading="lazy"><span class="tag">Golf day</span></figure><figure class="g-item" tabindex="0" style="--ar:1.336" data-full="./imgs/full/golf-04.jpg" data-alt="Glove and driver detail"><img src="./imgs/thumb/golf-04.jpg" alt="Glove and driver detail" loading="lazy"><span class="tag">Golf day</span></figure><figure class="g-item" tabindex="0" style="--ar:1.501" data-full="./imgs/full/golf-10.jpg" data-alt="Callaway ball held up to the lens"><img src="./imgs/thumb/golf-10.jpg" alt="Callaway ball held up to the lens" loading="lazy"><span class="tag">Golf day</span></figure></div>
    </section></div>
